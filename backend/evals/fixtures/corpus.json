      "chunks": [
        {
          "key": "vacation_policy_2024:c1",
          "page_number": 1,
          "section_title": "Carry-over",
          "text": "Vacation carry-over policy for 2024: employees may carry over up to 5 unused vacation days into 2025. Days above 5 expire on 31 December 2024."
        },
        {
          "key": "vacation_policy_2024:c2",
          "page_number": 2,
          "section_title": "Approval",
          "text": "Carry-over requests must be submitted to HR before 15 December 2024."
        }
      ]
    },
