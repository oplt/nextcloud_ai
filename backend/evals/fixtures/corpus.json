      "mime_type": "text/plain",
      "file_path": "/finance/asc606_comparison.txt",
      "tags": ["finance", "multi_evidence"],
      "visible_to": ["alice", "bob", "admin"],
      "chunks": [
        {
          "key": "revenue_recognition_asc606:c1",
          "page_number": 1,
          "section_title": "Before ASC 606",
          "text": "Before ASC 606, revenue recognition often followed industry-specific guidance and could recognize revenue when persuasive evidence of an arrangement existed."
        },
        {
          "key": "revenue_recognition_asc606:c2",
          "page_number": 2,
          "section_title": "After ASC 606",
          "text": "After ASC 606, revenue recognition uses a five-step model focused on transfer of control to the customer rather than risks-and-rewards transfer."
        }
      ]
    },
