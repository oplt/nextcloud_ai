APP_NAME=NextCloud AI Server
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_URL=["http://localhost:3000","http://localhost:5173"]
# Optional extra CORS origins (comma-separated), e.g. your Nextcloud base URL if not localhost:808x
# CORS_EXTRA_ORIGINS=http://cloud.example

POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://nextcloud:change-me@localhost:5432/nextcloud
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

JWT_SECRET_KEY=replace-with-openssl-rand-base64-64
SETTINGS_VAULT_KEY=replace-with-openssl-rand-base64-64
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_ISSUER=nextcloud-ai
AUTH_AUDIENCE=nextcloud-ai-users
AUTH_COOKIE_NAME=nc_ai_access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
CSRF_COOKIE_NAME=nc_ai_csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_SAMESITE=lax

FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=ChangeMe123!

EMBEDDING_DIM=1024
EMBEDDING_PROVIDER=ollama
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3:latest
OLLAMA_CHAT_MODEL=llama3:latest

# When true, citation/support failures log strict-path outcome but user sees citation-filtered model text (measure disagreements before tightening).
CHAT_VERIFICATION_SHADOW_MODE=false

# Product intelligence (insights, workflow tasks, graph). Set false for chat+search-only deployments.
PRODUCT_INTELLIGENCE_ENABLED=true
# off | inline (best-effort after index) | async (Celery task after index)
PRODUCT_INTELLIGENCE_EXTRACTION_MODE=async

NEXTCLOUD_BRIDGE_SHARED_SECRET=replace-with-openssl-rand-base64-64
NEXTCLOUD_BRIDGE_ISSUER=nextcloud-bridge
NEXTCLOUD_BRIDGE_AUDIENCE=fastapi-nextcloud
NEXTCLOUD_BRIDGE_TTL_SECONDS=60
NEXTCLOUD_BRIDGE_ALLOWED_CLOCK_SKEW_SECONDS=15
NEXTCLOUD_BRIDGE_REDIS_URL=
NEXTCLOUD_WEBHOOK_SECRET=
NEXTCLOUD_VERIFY_TLS=true
NEXTCLOUD_REQUEST_TIMEOUT_SECONDS=30
NEXTCLOUD_WEBHOOK_DEBOUNCE_SECONDS=30
NEXTCLOUD_FALLBACK_SYNC_INTERVAL_SECONDS=300
NEXTCLOUD_FALLBACK_STALE_AFTER_SECONDS=900

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
METRICS_ENABLED=true
METRICS_PATH=/metrics
REQUEST_ID_HEADER_NAME=X-Request-ID
TRACE_ID_HEADER_NAME=X-Trace-ID

LOG_LEVEL=INFO

RAG_VECTOR_TOP_K=60
RAG_KEYWORD_TOP_K=60
RAG_RERANK_TOP_K=40
RAG_TRUE_RERANK_TOP_K=24
RAG_FINAL_TOP_N=6
RAG_TRUE_RERANK_ENABLED=true
RAG_TRUE_RERANK_MODEL=BAAI/bge-reranker-v2-m3

