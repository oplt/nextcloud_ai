APP_NAME=NextCloud AI Server
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nextcloud_ai
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me
SETTINGS_VAULT_KEY=change-me-fernet-key
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_ISSUER=nextcloud-ai
AUTH_AUDIENCE=nextcloud-ai-users
AUTH_COOKIE_NAME=nc_ai_access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=ChangeMe123!

EMBEDDING_DIM=768
EMBEDDING_PROVIDER=deterministic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3:8b-instruct
LLM_PROVIDER=stub

NEXTCLOUD_BRIDGE_SHARED_SECRET=change-me
NEXTCLOUD_BRIDGE_ISSUER=nextcloud-bridge
NEXTCLOUD_BRIDGE_AUDIENCE=fastapi-nextcloud
NEXTCLOUD_BRIDGE_TTL_SECONDS=60
NEXTCLOUD_BRIDGE_ALLOWED_CLOCK_SKEW_SECONDS=15
NEXTCLOUD_BRIDGE_REDIS_URL=
NEXTCLOUD_WEBHOOK_SECRET=
NEXTCLOUD_VERIFY_TLS=true
NEXTCLOUD_REQUEST_TIMEOUT_SECONDS=30
VITE_API_BASE_URL=http://localhost:8000/api/v1
